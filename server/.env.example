# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=5000

# Local MongoDB from docker-compose.yml. For MongoDB Atlas, paste its mongodb+srv:// string.
MONGO_URI=mongodb://localhost:27017/notenest

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database used by `npm test`.
MONGO_URI_TEST=mongodb://localhost:27017/notenest_test

# Websites allowed to call the API ("*" = any). In production use the client URL.
CLIENT_ORIGIN=*
